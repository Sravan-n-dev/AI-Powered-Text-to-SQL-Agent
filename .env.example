# Copy this file to `.env` before running docker-compose.
# Never commit the real `.env` file.

# --- Postgres (target DB + vector store) ---
POSTGRES_USER=t2sql
POSTGRES_PASSWORD=t2sql_password
POSTGRES_DB=t2sql
# When running INSIDE docker-compose, host is the service name "postgres".
# When running scripts from your own machine (outside docker), use "localhost".
DATABASE_URL=postgresql://t2sql:t2sql_password@localhost:5432/t2sql

# --- Ollama ---
# When running INSIDE docker-compose, host is the service name "ollama".
# When running scripts from your own machine, use "localhost".
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SQL_MODEL=qwen2.5-coder:3b
OLLAMA_COMPLEX_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Safety thresholds ---
MAX_ESTIMATED_ROWS=1000000
QUERY_TIMEOUT_SECONDS=10
MAX_SQL_RETRIES=3

# --- App ---
LOG_LEVEL=INFO
